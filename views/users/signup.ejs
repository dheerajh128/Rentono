<% layout("/layouts/boilerplate.ejs") %>


    <div class="row mt-3">
        <h1 class="col-6 offset-3 ">SignUp for <b>Rentono</b></h1>
        <div class="col-6 offset-3 mt-2">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input placeholder="enter a username" type="text" name="username" id="username" class="form-control" required>
                    <div class="valid-feedback">That Looks Great!!</div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input placeholder="enter a email" type="text" name="email" id="email" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input placeholder="enter a password" type="password" name="password" id="password" class="form-control" required>
                </div>
                <button class="btn btn-success">SignUp</button>
                <hr>

            <a 
            href="/auth/google"
            class="btn btn-danger w-100"
            >
                <i class="fa-brands fa-google"></i>
                Continue with Google
            </a>

            <br>
            </form>
        </div>
    </div>
